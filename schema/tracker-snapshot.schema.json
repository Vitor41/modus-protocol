{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:unified-development-pipeline:schema:tracker-snapshot:0.1",
  "title": "Modus Protocol Tracker Snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": ["board_ref", "open_lists", "cards", "integration"],
  "properties": {
    "board_ref": { "$ref": "#/$defs/nonEmptyString" },
    "open_lists": {
      "type": "array",
      "items": { "$ref": "#/$defs/list" }
    },
    "cards": {
      "type": "array",
      "items": { "$ref": "#/$defs/card" }
    },
    "integration": { "$ref": "#/$defs/integration" },
    "active_execution": { "$ref": "#/$defs/activeExecution" },
    "delivery_groups": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/deliveryGroup" }
    }
  },
  "$defs": {
    "nonEmptyString": { "type": "string", "minLength": 1 },
    "integration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["comments"],
      "properties": {
        "comments": {
          "type": "object",
          "additionalProperties": false,
          "required": ["read", "write", "read_provider", "write_provider"],
          "properties": {
            "read": { "enum": ["verified", "unavailable", "not_tested"] },
            "write": { "enum": ["verified", "unavailable", "not_tested"] },
            "read_provider": { "enum": ["codex-connector", "environment", "mcp"] },
            "write_provider": { "enum": ["codex-connector", "environment", "mcp"] },
            "observation": { "$ref": "#/$defs/commentObservation" },
            "evidence_ref": { "$ref": "#/$defs/nonEmptyString" },
            "verified_at": { "$ref": "#/$defs/nonEmptyString" }
          }
        }
      }
    },
    "commentObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "observed_at", "card_refs"],
      "properties": {
        "scope": { "const": "all-actionable-cards" },
        "observed_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$" },
        "card_refs": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/nonEmptyString" } }
      }
    },
    "list": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "position"],
      "properties": {
        "ref": { "$ref": "#/$defs/nonEmptyString" },
        "name": { "$ref": "#/$defs/nonEmptyString" },
        "position": { "type": "number", "minimum": 0 }
      }
    },
    "signals": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "observed_list_ref": { "$ref": "#/$defs/nonEmptyString" },
        "observed_at": { "$ref": "#/$defs/nonEmptyString" },
        "state_entered_at": { "$ref": "#/$defs/nonEmptyString" },
        "awaiting_human": { "type": "boolean" },
        "human_wait_at": { "$ref": "#/$defs/nonEmptyString" },
        "human_resolution_at": { "$ref": "#/$defs/nonEmptyString" },
        "screen_evidence_present": { "type": "boolean" },
        "screen_approval_required": { "type": "boolean" },
        "screen_approval_valid": { "type": "boolean" },
        "screen_evidence_at": { "$ref": "#/$defs/nonEmptyString" },
        "screen_approval_at": { "$ref": "#/$defs/nonEmptyString" },
        "production_approval_valid": { "type": "boolean" },
        "production_approval_at": { "$ref": "#/$defs/nonEmptyString" },
        "business_question": { "type": "boolean" },
        "implementation_complete": { "type": "boolean" },
        "implementation_evidence_ref": { "$ref": "#/$defs/nonEmptyString" },
        "review_approved": { "type": "boolean" },
        "review_evidence_ref": { "$ref": "#/$defs/nonEmptyString" },
        "qa_approved": { "type": "boolean" },
        "human_gate_kind": {
          "enum": ["business_rule", "screen_approval", "production_approval", "loop_limit", "structural_scope", "systemic_risk", "external_authorization"]
        },
        "pending_transition": { "type": "boolean" },
        "pending_transition_from": { "$ref": "#/$defs/nonEmptyString" },
        "pending_transition_to": { "$ref": "#/$defs/nonEmptyString" },
        "pending_transition_role": { "$ref": "#/$defs/nonEmptyString" },
        "pending_transition_run_id": { "$ref": "#/$defs/nonEmptyString" },
        "pending_transition_evidence_ref": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "lock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run_id", "status"],
      "properties": {
        "run_id": { "$ref": "#/$defs/nonEmptyString" },
        "status": { "enum": ["active", "released", "blocked"] },
        "role": { "$ref": "#/$defs/nonEmptyString" },
        "state": { "$ref": "#/$defs/nonEmptyString" },
        "updated_at": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "card": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "list_ref", "position"],
      "properties": {
        "ref": { "$ref": "#/$defs/nonEmptyString" },
        "key": { "$ref": "#/$defs/nonEmptyString" },
        "title": { "$ref": "#/$defs/nonEmptyString" },
        "list_ref": { "$ref": "#/$defs/nonEmptyString" },
        "position": { "type": "number", "minimum": 0 },
        "signals": { "$ref": "#/$defs/signals" },
        "loop_counts": {
          "type": "object",
          "additionalProperties": { "type": "integer", "minimum": 0 }
        },
        "loop_state": { "$ref": "#/$defs/nonEmptyString" },
        "lock": { "$ref": "#/$defs/lock" },
        "delivery_group": { "$ref": "#/$defs/deliveryGroup" }
      }
    },
    "deliveryGroup": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "cards", "mode", "defined_by"],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmptyString" },
        "cards": { "type": "array", "minItems": 2, "uniqueItems": true, "items": { "$ref": "#/$defs/nonEmptyString" } },
        "branch": { "$ref": "#/$defs/nonEmptyString" },
        "mode": { "enum": ["optimization", "dependency"] },
        "depends_on": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/nonEmptyString" } },
        "defined_by": { "const": "pipeline-po" }
      }
    },
    "activeExecution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["architecture", "status", "run_id"],
      "properties": {
        "architecture": { "enum": ["legacy", "unified"] },
        "status": { "enum": ["active", "complete", "blocked"] },
        "run_id": { "$ref": "#/$defs/nonEmptyString" },
        "card_ref": { "$ref": "#/$defs/nonEmptyString" },
        "role": { "$ref": "#/$defs/nonEmptyString" },
        "state": { "$ref": "#/$defs/nonEmptyString" },
        "capsule_present": { "type": "boolean" }
      }
    }
  }
}
